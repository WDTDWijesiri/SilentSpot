rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(userId) { return signedIn() && request.auth.uid == userId; }

    match /users/{userId} {
      allow create, read: if owns(userId);
      allow update: if owns(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'points', 'favouriteSpotIDs']);
      allow delete: if owns(userId);

      match /measurements/{measurementId} {
        allow read, create: if owns(userId);
        allow update, delete: if false;
      }

      match /notifications/{notificationId} {
        allow read: if owns(userId);
        allow write: if false;
      }
    }

    match /quietSpots/{spotId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.submittedBy == request.auth.uid;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['currentDB', 'measurementCount', 'lastMeasured', 'isVerified']);
      allow delete: if signedIn() && resource.data.submittedBy == request.auth.uid;
    }

    match /measurements/{measurementId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userID == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
