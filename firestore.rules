rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(userId) { return signedIn() && request.auth.uid == userId; }

    match /users/{userId} {
      allow create, read: if owns(userId);
      allow update: if owns(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'points', 'lifetimePoints', 'favouriteSpotIDs',
                    'purchasedRewardIDs', 'equippedRewardID']);
      allow delete: if owns(userId);

      match /measurements/{measurementId} {
        allow read, create: if owns(userId);
        allow update, delete: if false;
      }

      match /notifications/{notificationId} {
        allow read: if owns(userId);
        allow create: if owns(userId)
          && request.resource.data.userID == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /quietSpots/{spotId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.submittedBy == request.auth.uid;
      allow update: if signedIn()
        && resource.data.submittedBy != request.auth.uid
        && resource.data.contributorIDs is list
        && !resource.data.contributorIDs.hasAny([request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['currentDB', 'measurementCount', 'lastMeasured', 'isVerified', 'contributorIDs'])
        && request.resource.data.measurementCount == resource.data.measurementCount + 1
        && request.resource.data.contributorIDs.size() == resource.data.contributorIDs.size() + 1
        && request.resource.data.contributorIDs.hasAll(resource.data.contributorIDs)
        && request.resource.data.contributorIDs.hasAny([request.auth.uid])
        && request.resource.data.currentDB >= 0
        && request.resource.data.currentDB <= 120
        && request.resource.data.isVerified == (
          request.resource.data.measurementCount >= request.resource.data.verificationTarget
          && request.resource.data.currentDB < 45
        );
      allow delete: if signedIn() && resource.data.submittedBy == request.auth.uid;
    }

    match /measurements/{measurementId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userID == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
